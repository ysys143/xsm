{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xsm:host-protocol:1:grant-result",
  "title": "Worker grant issuance snapshot, not execution or current validity",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "text",
        "grant"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "grant": {
          "$ref": "#/$defs/grant"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    {
      "$ref": "#/$defs/awaiting"
    }
  ],
  "$defs": {
    "grant": {
      "type": "object",
      "required": [
        "id",
        "runtime",
        "cwd",
        "options",
        "issued_at",
        "expires_at",
        "single_use",
        "asked_by"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?![\\s\\S])"
        },
        "runtime": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "full_access",
              "trust_hooks",
              "outside_scope",
              "remote"
            ]
          }
        },
        "issued_at": {
          "type": "number"
        },
        "expires_at": {
          "type": "number"
        },
        "single_use": {
          "const": true
        },
        "asked_by": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "awaiting": {
      "type": "object",
      "required": [
        "status",
        "decision_id",
        "question_id"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "waiting-for-user"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
