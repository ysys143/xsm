{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xsm:host-protocol:1:discovery-result",
  "title": "Experimental xsm_discover successful operation result",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/localCandidate"
          },
          {
            "$ref": "#/$defs/remoteCandidate"
          }
        ]
      }
    },
    "status": {
      "enum": [
        "ok",
        "unknown"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "unanswered": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "string",
            "minLength": 1
          }
        ]
      }
    },
    "inbox_pending": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "inbox_notice": {
      "type": "string"
    },
    "inbox_pending_known": {
      "type": "integer",
      "minimum": 0
    },
    "inbox_pending_diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "candidates",
    "status",
    "reason",
    "unanswered"
  ],
  "additionalProperties": false,
  "$defs": {
    "observation": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": "number"
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "status",
        "source",
        "timestamp",
        "observed_at",
        "freshness"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "todo": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "completed"
                ]
              }
            },
            "required": [
              "step",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": "number"
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "status",
        "source",
        "timestamp",
        "observed_at",
        "freshness"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "localHandle": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "home_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "machine": {
          "const": "local"
        }
      },
      "required": [
        "runtime",
        "session_id",
        "home_id",
        "machine"
      ],
      "additionalProperties": false
    },
    "remoteHandle": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "home_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "machine": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "runtime",
        "session_id",
        "home_id",
        "machine",
        "generation"
      ],
      "additionalProperties": false
    },
    "localCandidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "target": {
          "type": "string",
          "pattern": "^candidate:[0-9a-f]{64}(?![\\s\\S])"
        },
        "is_self": {
          "type": "boolean"
        },
        "handle": {
          "$ref": "#/$defs/localHandle"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "machine": {
          "const": "local"
        },
        "runtime": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "$ref": "#/$defs/observation"
        },
        "name_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "name_freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "discovery_basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "published",
              "same_repo",
              "same_repository"
            ]
          }
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "$ref": "#/$defs/observation"
        },
        "summary": {
          "$ref": "#/$defs/observation"
        },
        "todo": {
          "$ref": "#/$defs/todo"
        },
        "activity": {
          "$ref": "#/$defs/observation"
        },
        "state": {
          "$ref": "#/$defs/observation"
        },
        "receive": {
          "$ref": "#/$defs/observation"
        }
      },
      "required": [
        "id",
        "target",
        "is_self",
        "handle",
        "ref",
        "machine",
        "runtime",
        "name",
        "title",
        "name_source",
        "name_freshness",
        "discovery_basis",
        "repository",
        "branch",
        "summary",
        "todo",
        "activity",
        "state",
        "receive"
      ],
      "additionalProperties": false
    },
    "remoteCandidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "target": {
          "type": "string",
          "pattern": "^net:[0-9a-f]{64}:[a-z][a-z0-9-]{0,63}:[0-9a-f]{64}:.+(?![\\s\\S])"
        },
        "is_self": {
          "const": false
        },
        "handle": {
          "$ref": "#/$defs/remoteHandle"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "machine": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "runtime": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "$ref": "#/$defs/observation"
        },
        "name_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "name_freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "discovery_basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "published",
              "same_repo",
              "same_repository"
            ]
          }
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "$ref": "#/$defs/observation"
        },
        "summary": {
          "$ref": "#/$defs/observation"
        },
        "todo": {
          "$ref": "#/$defs/todo"
        },
        "activity": {
          "$ref": "#/$defs/observation"
        },
        "state": {
          "$ref": "#/$defs/observation"
        },
        "receive": {
          "$ref": "#/$defs/observation"
        },
        "repository_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "same_repository": {
          "enum": [
            true,
            null
          ]
        },
        "repository_status": {
          "enum": [
            "verified",
            "unknown"
          ]
        },
        "doing": {
          "$ref": "#/$defs/observation"
        },
        "machine_name": {
          "type": "string"
        },
        "origin_assurance": {
          "const": "authenticated-member"
        }
      },
      "required": [
        "id",
        "target",
        "is_self",
        "handle",
        "ref",
        "machine",
        "runtime",
        "name",
        "title",
        "name_source",
        "name_freshness",
        "discovery_basis",
        "repository",
        "branch",
        "summary",
        "todo",
        "activity",
        "state",
        "receive",
        "repository_id",
        "same_repository",
        "repository_status",
        "doing",
        "machine_name",
        "origin_assurance"
      ],
      "additionalProperties": false
    }
  }
}
