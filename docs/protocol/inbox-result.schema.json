{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xsm:host-protocol:1:inbox-result",
  "title": "xsm_inbox result and target-owned attachment metadata",
  "type": "object",
  "required": [
    "messages",
    "claims",
    "items",
    "inbox_pending"
  ],
  "additionalProperties": false,
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "inbox_pending": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "inbox_notice": {
      "type": "string"
    },
    "inbox_pending_known": {
      "type": "integer",
      "minimum": 0
    },
    "inbox_pending_diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "batch_limited": {
      "type": "boolean"
    },
    "next_after": {
      "type": [
        "string",
        "null"
      ]
    },
    "rendered_bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "id",
        "token",
        "owner",
        "generation",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "owner": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "kind",
        "wake"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "wake": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "files": {
          "$ref": "#/$defs/files"
        }
      }
    },
    "files": {
      "type": "object",
      "required": [
        "storage_id",
        "manifest_id",
        "version",
        "sha256",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "storage_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "files": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/fileEntry"
          }
        }
      }
    },
    "fileEntry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "size",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    }
  },
  "$comment": "items correspond in order to claims, not to unclaimed notices in messages. Metadata is not proof of reading or ACK. IDs are opaque; do not derive a filesystem path."
}
