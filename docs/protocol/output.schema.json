{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xsm:host-protocol:1:wire-output",
  "title": "Experimental xsm server output",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "result": true
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "data": true
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "events/available"
        },
        "params": {
          "$ref": "#/$defs/availableParams"
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "decision/request"
        },
        "params": {
          "$ref": "#/$defs/decisionParams"
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "initializeResult": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1"
        },
        "experimental": {
          "const": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "messaging",
              "inbox",
              "events",
              "user-decisions"
            ]
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "claimLeaseSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fileUploadChunkBytes": {
              "const": 196608
            },
            "fileUploadBudgetBytes": {
              "const": 4194304
            },
            "fileUploadSlots": {
              "const": 16
            }
          },
          "required": [
            "claimLeaseSeconds"
          ],
          "additionalProperties": false
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "protocolVersion",
        "experimental",
        "capabilities",
        "limits",
        "operations"
      ],
      "additionalProperties": false
    },
    "operationsResult": {
      "type": "object",
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "inputSchema": {
                "type": "object"
              },
              "annotations": {
                "type": "object"
              }
            },
            "required": [
              "name",
              "description",
              "inputSchema"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "operations"
      ],
      "additionalProperties": false
    },
    "sessionOpenResult": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^peer:[0-9a-f]{64}$"
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "messaging",
              "inbox",
              "events",
              "user-decisions"
            ]
          }
        }
      },
      "required": [
        "session",
        "generation",
        "ref",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "sessionUpdateResult": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "idle",
            "busy"
          ]
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "sessionCloseResult": {
      "type": "object",
      "properties": {
        "closed": {
          "const": true
        }
      },
      "required": [
        "closed"
      ],
      "additionalProperties": false
    },
    "subscribeResult": {
      "type": "object",
      "properties": {
        "subscribed": {
          "const": true
        }
      },
      "required": [
        "subscribed"
      ],
      "additionalProperties": false
    },
    "operationResult": {
      "type": "object",
      "description": "A declared structured operation object, a text envelope, or waiting-for-user. Per-operation domain schemas remain incomplete."
    },
    "releaseResult": {
      "type": "object",
      "properties": {
        "released": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "released"
      ],
      "additionalProperties": false
    },
    "deliveryResult": {
      "type": "object",
      "properties": {
        "recorded": {
          "enum": [
            "queued",
            "admitted",
            "refused",
            "unknown"
          ]
        },
        "acknowledged": {
          "const": false
        }
      },
      "required": [
        "recorded",
        "acknowledged"
      ],
      "additionalProperties": false
    },
    "decisionResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "decision_id"
      ],
      "additionalProperties": false
    },
    "availableParams": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "session",
        "ids"
      ],
      "additionalProperties": false
    },
    "decisionParams": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "decisionId": {
          "type": "string",
          "minLength": 1
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "challenge": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "requestedSchema": {
          "type": "object"
        },
        "expiresAt": {
          "type": "number"
        }
      },
      "required": [
        "session",
        "decisionId",
        "questionId",
        "challenge",
        "question",
        "requestedSchema",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "uploadProgress": {
      "type": "object",
      "properties": {
        "state": {
          "const": "uploading"
        },
        "upload": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "offsets": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "chunk_bytes": {
          "const": 196608
        }
      },
      "required": [
        "state",
        "upload",
        "request_id",
        "offsets",
        "chunk_bytes"
      ],
      "additionalProperties": false
    },
    "uploadFrozen": {
      "type": "object",
      "properties": {
        "state": {
          "const": "frozen"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "body_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest": {
          "type": "object"
        },
        "mode": {
          "enum": [
            "files",
            "inline"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "body_sent": {
          "const": false
        }
      },
      "required": [
        "state",
        "request_id",
        "manifest_id"
      ],
      "additionalProperties": false
    },
    "uploadStatus": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "uploading"
            },
            "upload": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "offsets": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "chunk_bytes": {
              "const": 196608
            }
          },
          "required": [
            "state",
            "upload",
            "request_id",
            "offsets",
            "chunk_bytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "frozen"
            },
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "manifest_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "body_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "manifest": {
              "type": "object"
            },
            "mode": {
              "enum": [
                "files",
                "inline"
              ]
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "body_sent": {
              "const": false
            }
          },
          "required": [
            "state",
            "request_id",
            "manifest_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unknown"
            },
            "request_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "request_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "uploadWrite": {
      "type": "object",
      "properties": {
        "upload": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "entry": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "upload",
        "entry",
        "offset"
      ],
      "additionalProperties": false
    },
    "uploadAbort": {
      "type": "object",
      "properties": {
        "aborted": {
          "const": true
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "body_sent": {
          "const": false
        }
      },
      "required": [
        "aborted",
        "request_id",
        "body_sent"
      ],
      "additionalProperties": false
    }
  },
  "x-methodResults": {
    "initialize": "#/$defs/initializeResult",
    "operations/list": "#/$defs/operationsResult",
    "session.open": "#/$defs/sessionOpenResult",
    "session.update": "#/$defs/sessionUpdateResult",
    "session.close": "#/$defs/sessionCloseResult",
    "events.subscribe": "#/$defs/subscribeResult",
    "operation.call": "#/$defs/operationResult",
    "inbox.release": "#/$defs/releaseResult",
    "delivery.report": "#/$defs/deliveryResult",
    "decision.response": "#/$defs/decisionResult",
    "decision.abandon": "#/$defs/decisionResult",
    "files.upload.open": "#/$defs/uploadStatus",
    "files.upload.write": "#/$defs/uploadWrite",
    "files.upload.commit": "#/$defs/uploadFrozen",
    "files.upload.status": "#/$defs/uploadStatus",
    "files.upload.abort": "#/$defs/uploadAbort"
  }
}
