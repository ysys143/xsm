{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xsm:host-protocol:1:wire-output",
  "title": "Experimental xsm server output",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "result": true
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "data": true
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "events/available"
        },
        "params": {
          "$ref": "#/$defs/availableParams"
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "decision/request"
        },
        "params": {
          "$ref": "#/$defs/decisionParams"
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "initializeResult": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1"
        },
        "experimental": {
          "const": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "messaging",
              "inbox",
              "events",
              "user-decisions"
            ]
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "claimLeaseSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fileUploadChunkBytes": {
              "const": 196608
            },
            "fileUploadBudgetBytes": {
              "const": 4194304
            },
            "fileUploadSlots": {
              "const": 16
            }
          },
          "required": [
            "claimLeaseSeconds"
          ],
          "additionalProperties": false
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "protocolVersion",
        "experimental",
        "capabilities",
        "limits",
        "operations"
      ],
      "additionalProperties": false
    },
    "operationsResult": {
      "type": "object",
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "inputSchema": {
                "type": "object"
              },
              "annotations": {
                "type": "object"
              }
            },
            "required": [
              "name",
              "description",
              "inputSchema"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "operations"
      ],
      "additionalProperties": false
    },
    "sessionOpenResult": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^peer:[0-9a-f]{64}(?![\\s\\S])"
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "messaging",
              "inbox",
              "events",
              "user-decisions"
            ]
          }
        }
      },
      "required": [
        "session",
        "generation",
        "ref",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "sessionUpdateResult": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "idle",
            "busy"
          ]
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "sessionCloseResult": {
      "type": "object",
      "properties": {
        "closed": {
          "const": true
        }
      },
      "required": [
        "closed"
      ],
      "additionalProperties": false
    },
    "subscribeResult": {
      "type": "object",
      "properties": {
        "subscribed": {
          "const": true
        }
      },
      "required": [
        "subscribed"
      ],
      "additionalProperties": false
    },
    "operationResult": {
      "type": "object",
      "description": "A declared structured operation object, a text envelope, or waiting-for-user. Per-operation domain schemas remain incomplete."
    },
    "releaseResult": {
      "type": "object",
      "properties": {
        "released": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "released"
      ],
      "additionalProperties": false
    },
    "deliveryResult": {
      "type": "object",
      "properties": {
        "recorded": {
          "enum": [
            "queued",
            "admitted",
            "refused",
            "unknown"
          ]
        },
        "acknowledged": {
          "const": false
        }
      },
      "required": [
        "recorded",
        "acknowledged"
      ],
      "additionalProperties": false
    },
    "decisionResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "decision_id"
      ],
      "additionalProperties": false
    },
    "availableParams": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "session",
        "ids"
      ],
      "additionalProperties": false
    },
    "decisionParams": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "decisionId": {
          "type": "string",
          "minLength": 1
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "challenge": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "requestedSchema": {
          "type": "object"
        },
        "expiresAt": {
          "type": "number"
        }
      },
      "required": [
        "session",
        "decisionId",
        "questionId",
        "challenge",
        "question",
        "requestedSchema",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "uploadProgress": {
      "type": "object",
      "properties": {
        "state": {
          "const": "uploading"
        },
        "upload": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "offsets": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "chunk_bytes": {
          "const": 196608
        }
      },
      "required": [
        "state",
        "upload",
        "request_id",
        "offsets",
        "chunk_bytes"
      ],
      "additionalProperties": false
    },
    "uploadFrozen": {
      "type": "object",
      "properties": {
        "state": {
          "const": "frozen"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
        },
        "body_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "manifest": {
          "$ref": "#/$defs/fileManifest"
        },
        "mode": {
          "enum": [
            "files",
            "inline"
          ]
        },
        "references": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/fileReference"
          }
        },
        "body_sent": {
          "const": false
        }
      },
      "required": [
        "state",
        "request_id",
        "manifest_id"
      ],
      "additionalProperties": false
    },
    "uploadStatus": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "uploading"
            },
            "upload": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
            },
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "offsets": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "chunk_bytes": {
              "const": 196608
            }
          },
          "required": [
            "state",
            "upload",
            "request_id",
            "offsets",
            "chunk_bytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "frozen"
            },
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "manifest_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
            },
            "body_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "manifest": {
              "$ref": "#/$defs/fileManifest"
            },
            "mode": {
              "enum": [
                "files",
                "inline"
              ]
            },
            "references": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/fileReference"
              }
            },
            "body_sent": {
              "const": false
            }
          },
          "required": [
            "state",
            "request_id",
            "manifest_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unknown"
            },
            "request_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "request_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "uploadWrite": {
      "type": "object",
      "properties": {
        "upload": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
        },
        "entry": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "upload",
        "entry",
        "offset"
      ],
      "additionalProperties": false
    },
    "uploadAbort": {
      "type": "object",
      "properties": {
        "aborted": {
          "const": true
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "body_sent": {
          "const": false
        }
      },
      "required": [
        "aborted",
        "request_id",
        "body_sent"
      ],
      "additionalProperties": false
    },
    "fileClaim": {
      "type": "object",
      "required": [
        "id",
        "token",
        "owner",
        "generation",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "owner": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "fileManifestEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "original_name": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "copy": {
          "const": true
        },
        "input_source": {
          "enum": [
            "cli-os-read",
            "caller-inline"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "original_name",
        "source_version",
        "size",
        "sha256",
        "copy",
        "input_source"
      ],
      "additionalProperties": false
    },
    "fileManifest": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "xsm.files/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "home_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "runtime",
            "home_id",
            "session_id"
          ],
          "additionalProperties": false
        },
        "binding": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "body_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "request_id",
            "body_sha256"
          ],
          "additionalProperties": false
        },
        "created_at": {
          "type": "number",
          "minimum": 0
        },
        "expires_at": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "files": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/fileManifestEntry"
          }
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "schema",
        "id",
        "version",
        "previous",
        "owner",
        "binding",
        "created_at",
        "expires_at",
        "files",
        "size",
        "sha256"
      ],
      "additionalProperties": false
    },
    "fileReference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^manifest:[0-9a-f]{32}(?![\\s\\S])"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        }
      },
      "required": [
        "path",
        "id",
        "version",
        "sha256",
        "size"
      ],
      "additionalProperties": false
    },
    "fileManifestResult": {
      "type": "object",
      "properties": {
        "storage_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
        },
        "manifest": {
          "$ref": "#/$defs/fileManifest"
        },
        "inbox_pending": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "inbox_notice": {
          "type": "string"
        },
        "inbox_pending_known": {
          "type": "integer",
          "minimum": 0
        },
        "inbox_pending_diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incoming": {
          "type": "object",
          "properties": {
            "messages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "claims": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fileClaim"
              }
            },
            "batch_limited": {
              "type": "boolean"
            },
            "next_after": {
              "type": [
                "string",
                "null"
              ]
            },
            "rendered_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "messages",
            "claims"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "storage_id",
        "manifest"
      ],
      "additionalProperties": false
    },
    "fileEntryResult": {
      "type": "object",
      "properties": {
        "storage_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
        },
        "entry_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
        },
        "encoding": {
          "enum": [
            "text",
            "base64"
          ]
        },
        "content": {
          "type": "string"
        },
        "inbox_pending": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "inbox_notice": {
          "type": "string"
        },
        "inbox_pending_known": {
          "type": "integer",
          "minimum": 0
        },
        "inbox_pending_diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incoming": {
          "type": "object",
          "properties": {
            "messages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "claims": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fileClaim"
              }
            },
            "batch_limited": {
              "type": "boolean"
            },
            "next_after": {
              "type": [
                "string",
                "null"
              ]
            },
            "rendered_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "messages",
            "claims"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "storage_id",
        "entry_id",
        "encoding",
        "content"
      ],
      "additionalProperties": false
    },
    "fileCanonicalResult": {
      "type": "object",
      "properties": {
        "storage_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
        },
        "canonical_format": {
          "const": "xsm.files/v1"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "encoding": {
          "const": "base64"
        },
        "content": {
          "type": "string"
        },
        "inbox_pending": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "inbox_notice": {
          "type": "string"
        },
        "inbox_pending_known": {
          "type": "integer",
          "minimum": 0
        },
        "inbox_pending_diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incoming": {
          "type": "object",
          "properties": {
            "messages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "claims": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fileClaim"
              }
            },
            "batch_limited": {
              "type": "boolean"
            },
            "next_after": {
              "type": [
                "string",
                "null"
              ]
            },
            "rendered_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "messages",
            "claims"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "storage_id",
        "canonical_format",
        "manifest_sha256",
        "encoding",
        "content"
      ],
      "additionalProperties": false
    },
    "fileResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/fileManifestResult"
        },
        {
          "$ref": "#/$defs/fileEntryResult"
        },
        {
          "$ref": "#/$defs/fileCanonicalResult"
        }
      ]
    }
  },
  "x-methodResults": {
    "initialize": "#/$defs/initializeResult",
