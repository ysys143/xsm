    "closedConsent": {
      "type": "object",
      "properties": {
        "inbox_pending": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "inbox_notice": {
          "type": "string"
        },
        "inbox_pending_known": {
          "type": "integer",
          "minimum": 0
        },
        "inbox_pending_diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incoming": {
          "type": "object",
          "properties": {
            "messages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "claims": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/claim"
              }
            }
          },
          "required": [
            "messages",
            "claims"
          ],
          "additionalProperties": false
        },
        "closed": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "closed",
        "inbox_pending"
      ],
      "additionalProperties": false
    }
  }
}
