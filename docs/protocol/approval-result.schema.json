{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xsm:host-protocol:1:approval-result",
  "title": "Worker permission answer snapshot, not worker execution, effect, or native UI evidence",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "text",
        "approval"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    {
      "$ref": "#/$defs/awaiting"
    }
  ],
  "$defs": {
    "approval": {
      "type": "object",
      "required": [
        "id",
        "worker",
        "status",
        "summary",
        "tool",
        "answered_at",
        "via",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,160}(?![\\s\\S])"
        },
        "worker": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
        },
        "status": {
          "enum": [
            "approved",
            "denied"
          ]
        },
        "summary": {
          "type": "string"
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "answered_at": {
          "type": "number"
        },
        "via": {
          "enum": [
            "typed-command",
            "input-consent",
            "agent-supplied",
            "native-user",
            "host-user",
            "mcp-elicitation"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "awaiting": {
      "type": "object",
      "required": [
        "status",
        "decision_id",
        "question_id"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "waiting-for-user"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
