{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xsm:host-protocol:1:request",
  "title": "Experimental xsm host request",
  "type": "object",
  "required": [
    "jsonrpc",
    "id",
    "method"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "initialize",
        "operations/list",
        "session.open",
        "session.update",
        "session.close",
        "events.subscribe",
        "operation.call",
        "inbox.release",
        "delivery.report",
        "decision.response",
        "decision.abandon"
      ]
    },
    "params": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sessionOpen": {
      "type": "object",
      "required": [
        "runtime",
        "profile",
        "conversation",
        "cwd"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "not": {
            "enum": [
              "claude",
              "codex"
            ]
          }
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "conversation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "messaging",
              "inbox",
              "events",
              "user-decisions"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "decisionResponse": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "challenge": {
          "type": "string",
          "minLength": 1
        },
        "displayed": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "accept",
            "decline",
            "cancel"
          ]
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session",
        "questionId",
        "challenge",
        "displayed",
        "action",
        "answer",
        "source_id"
      ],
      "additionalProperties": false
    },
    "decisionAbandon": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "challenge": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session",
        "questionId",
        "challenge"
      ],
      "additionalProperties": false
    },
    "inboxRelease": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "session",
        "tokens"
      ],
      "additionalProperties": false
    },
    "deliveryReport": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "queued",
            "admitted",
            "refused",
            "unknown"
          ]
        },
        "token": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session",
        "id",
        "state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "admitted"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "token"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "initialize": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "protocolVersion"
      ],
      "additionalProperties": false
    },
    "empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "sessionUpdate": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "idle",
            "busy"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "session"
      ],
      "additionalProperties": false
    },
    "sessionBound": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session"
      ],
      "additionalProperties": false
    },
    "operationCall": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        }
      },
      "required": [
        "session",
        "operation"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "initialize"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/initialize"
          }
        },
        "required": [
          "params"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "operations/list"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/empty"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "session.open"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/sessionOpen"
          }
        },
        "required": [
          "params"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "session.update"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/sessionUpdate"
          }
        },
        "required": [
          "params"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "session.close"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/sessionBound"
          }
        },
        "required": [
          "params"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "events.subscribe"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/sessionBound"
          }
        },
        "required": [
          "params"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "operation.call"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/operationCall"
          }
        },
        "required": [
          "params"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "inbox.release"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/inboxRelease"
          }
        },
        "required": [
          "params"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "delivery.report"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/deliveryReport"
          }
        },
        "required": [
          "params"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "decision.response"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/decisionResponse"
          }
        },
        "required": [
          "params"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "decision.abandon"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/decisionAbandon"
          }
        },
        "required": [
          "params"
        ]
      }
    }
  ]
}
