{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xsm:host-protocol:1:request",
  "title": "Experimental xsm host request",
  "type": "object",
  "required": [
    "jsonrpc",
    "id",
    "method"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "method": {
      "type": "string"
    },
    "params": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sessionOpen": {
      "type": "object",
      "required": [
        "runtime",
        "profile",
        "conversation",
        "cwd"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "not": {
            "enum": [
              "claude",
              "codex"
            ]
          }
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "conversation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "messaging",
              "inbox",
              "events",
              "user-decisions"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "decisionResponse": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "challenge": {
          "type": "string",
          "minLength": 1
        },
        "displayed": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "accept",
            "decline",
            "cancel"
          ]
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session",
        "questionId",
        "challenge",
        "displayed",
        "action",
        "answer",
        "source_id"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "session.open"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "required": [
          "params"
        ],
        "properties": {
          "params": {
            "$ref": "#/$defs/sessionOpen"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "decision.response"
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "required": [
          "params"
        ],
        "properties": {
          "params": {
            "$ref": "#/$defs/decisionResponse"
          }
        }
      }
    }
  ]
}
