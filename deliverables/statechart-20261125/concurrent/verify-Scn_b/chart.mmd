---
title: "xsm: concurrent handovers. A holds the team place and asked a question that is still open"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: running
    lg1: answered
    lg2: Breaks AddressAndPlaceAgree or AddressLeadsAway or HandedOverHoldsNoPlace or LateAnswerRecorded or QuestionHolderIsAddressTarget
    lg3: Path to the AddressAndPlaceAgree or AddressLeadsAway or HandedOverHoldsNoPlace or LateAnswerRecorded or QuestionHolderIsAddressTarget bug
  }
  class lg0 orange
  class lg1 teal
  class lg2 breaks
  class lg3 bugPath
  state "At the same time" as all {
    state "Handover A to B" as r0 {
      s0: not started
      s1: approved and checked
      s2: team seat moved
      s3: pending question moved
      s4: record written
      [*] --> s0
      s0 --> s1: the person approves A to B and it passes its check [when Handover B to A is not record written and Records is no handover record and Question is open, asked by A]
      s1 --> s2: A to B moves the team seat
      s2 --> s3: A to B moves the pending question
      s3 --> s4: A to B writes its handover record
    }
    --
    state "Handover B to A" as r1 {
      s5: not started
      s6: approved and checked
      s7: team seat moved
      s8: pending question moved
      s9: record written
      [*] --> s5
      s5 --> s6: the person approves B to A and it passes its check [when Handover A to B is not record written and Records is no handover record and Address is DMs to A reach A and Question is not late answer stored for B]
      s6 --> s7: B to A moves the team seat
      s7 --> s8: B to A moves the pending question
      s8 --> s9: B to A writes its handover record
    }
    --
    state "Team" as r2 {
      s10: members: A#59; lead seat: A
      s11: members: B#59; lead seat: B
      [*] --> s10
      s10 --> s11: A to B moves the team seat [when Handover A to B is approved and checked and Records is one of B handed to A, no handover record and Address is DMs to A reach A and Question is open, asked by A]
      s11 --> s10: B to A moves the team seat [when Handover B to A is approved and checked and Records is one of A handed to B, no handover record and Address is not DMs to A loop back to A and Question is one of open, asked by A, open, asked by B]
    }
    --
    state "Records" as r3 {
      s12: no handover record
      s13: B handed to A
      s14: A handed to B
      s15: A handed to B, B handed to A
      [*] --> s12
      s12 --> s13: B to A writes its handover record [when Handover B to A is pending question moved]
      s12 --> s14: A to B writes its handover record [when Handover A to B is pending question moved]
      s13 --> s15: A to B writes its handover record [when Handover A to B is pending question moved and Question is not late answer stored for A]
      s14 --> s15: B to A writes its handover record [when Handover B to A is pending question moved and Question is not late answer stored for B]
    }
    --
    state "Address" as r4 {
      s16: DMs to A reach A
      s17: DMs to A reach B
      s18: DMs to A loop back to A
      [*] --> s16
      s16 --> s17: A to B writes its handover record [when Handover A to B is pending question moved and Handover B to A is not record written and Records is no handover record and Question is not late answer stored for A]
      s16 --> s18: A to B writes its handover record [when Handover A to B is pending question moved and Handover B to A is record written and Records is B handed to A and Question is not late answer stored for A]
      s17 --> s18: B to A writes its handover record [when Handover B to A is pending question moved and Question is not late answer stored for B]
    }
    --
    state "Question" as r5 {
      s19: open, asked by A
      s20: open, asked by B
      s21: late answer stored for A
      s22: late answer stored for B
      s23: late answer sent to A, not stored: the question is B's
      [*] --> s19
      s19 --> s20: A to B moves the pending question [when Handover A to B is team seat moved and Records is one of B handed to A, no handover record and Address is DMs to A reach A]
      s19 --> s21: the peer's late answer arrives and is stored [when Handover A to B is one of not started, record written and Handover B to A is record written and Records is one of A handed to B, B handed to A, B handed to A and Address is not DMs to A reach B]
      s20 --> s22: the peer's late answer arrives and is stored [when Handover A to B is record written and Handover B to A is not started and Team is members: B#59; lead seat: B and Records is A handed to B and Address is DMs to A reach B]
      s20 --> s19: B to A moves the pending question [when Handover B to A is team seat moved and Records is one of A handed to B, no handover record and Address is not DMs to A loop back to A]
      s20 --> s23: the peer's late answer arrives and is refused [when Handover A to B is record written and Handover B to A is record written and Records is A handed to B, B handed to A and Address is DMs to A loop back to A]
    }
  }
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s0 bugPath
  class s1 orange
  class s1 bugPath
  class s2 orange
  class s2 bugPath
  class s3 orange
  class s3 bugPath
  class s4 bugPath
  class s5 bugPath
