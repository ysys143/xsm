---
title: "xsm: concurrent handovers. A holds the team place and asked a question that is still open"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: running
    lg1: answered
  }
  class lg0 orange
  class lg1 teal
  state "At the same time" as all {
    state "Handover A to B" as r0 {
      s0: not started
      s1: holds the lock, passed its check
      s2: record written
      s3: team seat moved
      s4: pending question moved
      s5: done, lock released
      s6: refused, nothing changed
      [*] --> s0
      s0 --> s1: the person approves A to B#59; it takes the lock and passes its check [when Handover B to A is not started and Records is no handover record and Question is open, asked by A]
      s1 --> s2: A to B writes its handover record
      s2 --> s3: A to B moves the team seat
      s3 --> s4: A to B moves the pending question
      s4 --> s5: A to B finishes and releases the lock
      s0 --> s6: the person approves A to B and it is refused (already handed over, or a cycle) [when Handover B to A is done, lock released and Records is B handed to A]
    }
    --
    state "Handover B to A" as r1 {
      s7: not started
      s8: holds the lock, passed its check
      s9: record written
      s10: team seat moved
      s11: pending question moved
      s12: done, lock released
      s13: refused, nothing changed
      [*] --> s7
      s7 --> s8: the person approves B to A#59; it takes the lock and passes its check [when Handover A to B is not started and Team is members: A#59; lead seat: A and Records is no handover record and Address is DMs to A reach A and Question is open, asked by A]
      s8 --> s9: B to A writes its handover record
      s9 --> s10: B to A moves the team seat
      s10 --> s11: B to A moves the pending question
      s11 --> s12: B to A finishes and releases the lock
      s7 --> s13: the person approves B to A and it is refused (already handed over, or a cycle) [when Handover A to B is done, lock released and Team is members: B#59; lead seat: B and Records is A handed to B and Address is DMs to A reach B and Question is not open, asked by A]
    }
    --
    state "Team" as r2 {
      s14: members: A#59; lead seat: A
      s15: members: B#59; lead seat: B
      [*] --> s14
      s14 --> s15: A to B moves the team seat [when Handover A to B is record written and Handover B to A is not started and Records is A handed to B and Address is DMs to A reach B and Question is open, asked by A]
    }
    --
    state "Records" as r3 {
      s16: no handover record
      s17: B handed to A
      s18: A handed to B
      [*] --> s16
      s16 --> s18: A to B writes its handover record [when Handover A to B is holds the lock, passed its check and Handover B to A is not started]
      s16 --> s17: B to A writes its handover record [when Handover A to B is not started and Handover B to A is holds the lock, passed its check]
    }
    --
    state "Address" as r4 {
      s19: DMs to A reach A
      s20: DMs to A reach B
      [*] --> s19
      s19 --> s20: A to B writes its handover record [when Handover A to B is holds the lock, passed its check and Handover B to A is not started and Records is no handover record and Question is open, asked by A]
    }
    --
    state "Question" as r5 {
      s21: open, asked by A
      s22: open, asked by B
      s23: late answer stored for A
      s24: late answer stored for B
      [*] --> s21
      s21 --> s22: A to B moves the pending question [when Handover A to B is team seat moved and Handover B to A is not started and Team is members: B#59; lead seat: B and Records is A handed to B and Address is DMs to A reach B]
      s21 --> s23: the peer's late answer arrives and is stored [when Handover A to B is one of not started, refused, nothing changed and Handover B to A is done, lock released and Team is members: A#59; lead seat: A and Records is B handed to A and Address is DMs to A reach A]
      s22 --> s24: the peer's late answer arrives and is stored [when Handover A to B is done, lock released]
    }
  }
